{
	"name": "aiife",
	"version": "1.0.0",
	"description": "Interactive fiction engine with LLM parser",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"aiife": "dist/index.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./sdk": {
			"types": "./dist/sdk.d.ts",
			"import": "./dist/sdk.js"
		}
	},
	"files": [
		"dist",
		"games"
	],
	"scripts": {
		"build": "tsup",
		"dev": "DEBUG=true tsx --env-file=.env src/index.ts",
		"watch": "tsx watch --env-file=.env src/index.ts",
		"start": "tsx --env-file=.env src/index.ts",
		"lint": "biome check --unsafe --write .",
		"format": "biome format --write .",
		"biome": "npm run format && npm run lint",
		"eval": "npx lmnr eval",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.46",
		"@ai-sdk/google": "^3.0.46",
		"@ai-sdk/openai": "^3.0.30",
		"@lmnr-ai/lmnr": "^0.8.11",
		"ai": "^6.0.97",
		"immer": "^11.1.4",
		"ink": "^6.8.0",
		"ink-spinner": "^5.0.0",
		"react": "^19.2.4",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@types/node": "^22.0.0",
		"@types/react": "^19.2.14",
		"tsup": "^9.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^4.0.18"
	}
}
