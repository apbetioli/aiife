# LLM provider: anthropic | openai | ollama | google
LLM_PROVIDER=anthropic
EVAL_PROVIDER=openai

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
INTENT_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
EVAL_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI
OPENAI_API_KEY=sk-...
INTENT_OPENAI_MODEL=gpt-4o-mini
EVAL_OPENAI_MODEL=gpt-4o-mini

# Ollama (uses OpenAI-compatible API)
OLLAMA_BASE_URL=http://localhost:11434/v1
INTENT_OLLAMA_MODEL=qwen3.5:3b
EVAL_OLLAMA_MODEL=qwen3.5:3b

# Google
GOOGLEAI_API_KEY=...
INTENT_GOOGLEAI_MODEL=gemini-3.8-flash
EVAL_GOOGLEAI_MODEL=gemini-3.8-flash

# Timeout for LLM calls in ms (prevents hang when Ollama/server is unreachable). Default 60000.
# LLM_TIMEOUT_MS=60000

# Laminar
LMNR_PROJECT_API_KEY=...